# Copy to .env and fill in. .env is git-ignored and must never be committed.

# ---------------------------------------------------------------------------- database ----
POSTGRES_DB=sentinel
POSTGRES_USER=sentinel
# Generate one, for example: openssl rand -base64 32
POSTGRES_PASSWORD=

# ------------------------------------------------------------------------ application ----
ASPNETCORE_ENVIRONMENT=Production
WEB_PORT=8080

# Applies pending migrations on boot. Fine for a single instance; with several replicas,
# set this to false and run migrations as a separate deployment step.
DATABASE_MIGRATE_ON_STARTUP=true

# ------------------------------------------------------------------------------ proxy ----
# Number of reverse proxies in front of the app. 0 disables X-Forwarded-* handling entirely.
# Leave this at 0 unless a proxy you control is the only way in: trusting the header when it
# can be set by a client lets that client forge its own address in the audit log.
FORWARDED_HEADER_HOPS=1

# Turn off only if TLS genuinely terminates elsewhere and the app is unreachable over plain
# HTTP from outside. It is refused outright in Production.
SECURITY_REQUIRE_HTTPS=true

# ------------------------------------------------------------ first administrator ----
# Set these for the very first boot only. Seeding is a no-op once any SuperAdmin exists.
# After signing in and changing the password, clear these values and redeploy.
SEED_SUPERADMIN_ENABLED=false
SEED_SUPERADMIN_USERNAME=
SEED_SUPERADMIN_EMAIL=
SEED_SUPERADMIN_PASSWORD=
