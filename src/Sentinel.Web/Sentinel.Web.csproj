<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <UserSecretsId>sentinel-portal-web</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Sentinel.Infrastructure\Sentinel.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Diagnostics.HealthChecks.EntityFrameworkCore" />
    <PackageReference Include="Serilog.AspNetCore" />
    <PackageReference Include="Serilog.Sinks.Console" />
    <PackageReference Include="Serilog.Formatting.Compact" />
  </ItemGroup>

  <ItemGroup>
    <!-- Front-end sources and tooling never ship; only the built bundles under
         wwwroot/js/dist do, and those are committed so `dotnet run` works without Node. -->
    <Content Remove="node_modules\**" />
    <None Remove="node_modules\**" />
    <Compile Remove="node_modules\**" />
    <Content Remove="Scripts\**" />
    <None Include="Scripts\**" />
    <Content Remove="package.json" />
    <Content Remove="package-lock.json" />
  </ItemGroup>

  <ItemGroup>
    <!-- Translations are read from the content root at runtime, so they must travel with
         the published output. -->
    <Content Update="Resources\**\*.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Sentinel.IntegrationTests" />
  </ItemGroup>

</Project>
