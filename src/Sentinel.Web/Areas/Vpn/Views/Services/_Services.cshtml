@using Sentinel.Domain.Subscriptions
@using Sentinel.Vpn.Domain
@using Sentinel.Web.Areas.Vpn.Models
@model VpnProductViewModel
@{
    var isPersian = CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "fa";
    var now = DateTimeOffset.UtcNow;

    static string Bytes(long? value) => value is null ? "—" : ByteSize.Describe(value.Value);
}

<div class="stack stack--tight">
    @*
        Services this portal provisions come first: they are the ones it can actually act on, and a
        member looking for the link they were sold should not have to scroll past links they pasted
        in themselves.
    *@
    @foreach (var service in Model.ManagedServices)
    {
        var title = isPersian ? service.PlanNameFa : service.PlanNameEn;
        var link = service.DeliveryToken is { } token
            ? $"{Model.DeliveryBaseUrl}/s/{token}"
            : null;

        <section class="card">
            <div class="card__header">
                <div style="min-inline-size:0">
                    <h2 class="card__title">@title</h2>
                    <p class="card__hint">
                        @L["vpn.service.managed"]
                        @if (!string.IsNullOrEmpty(service.CountryCode))
                        {
                            <span aria-hidden="true">·</span>
                            <span dir="ltr">@service.CountryCode</span>
                        }
                    </p>
                </div>

                <div class="cluster">
                    <span class="badge @PlanPresentation.ServiceStatusBadgeClass(service.Status)">
                        @L[PlanPresentation.ServiceStatusKey(service.Status)]
                    </span>
                </div>
            </div>

            @if (service.Status == CustomerServiceStatus.NeedsAttention)
            {
                @* Says what is happening without naming a panel, a server or an error. The member's
                   part in this is to wait; the detail belongs in the operator's view. *@
                <p class="alert alert--warning" style="margin-block-start:var(--space-4)">
                    @L["vpn.service.needsAttention.hint"]
                </p>
            }

            <dl class="detail-list">
                <div>
                    <dt>@L["vpn.service.used"]</dt>
                    <dd dir="ltr">@Bytes(service.UsedBytes)</dd>
                </div>
                <div>
                    <dt>@L["vpn.service.allowance"]</dt>
                    <dd dir="ltr">
                        @(service.IsUnlimitedTraffic
                            ? L["plan.unlimited"].Value
                            : Bytes(service.TrafficBytes))
                    </dd>
                </div>
                <div>
                    <dt>@L["vpn.service.remaining"]</dt>
                    <dd dir="ltr">
                        @(service.IsUnlimitedTraffic ? "—" : Bytes(service.RemainingBytes))
                    </dd>
                </div>
                <div>
                    <dt>@L["vpn.service.expires"]</dt>
                    <dd>
                        @if (service.ExpiresAt is { } expires)
                        {
                            <time datetime="@UserTime.ToIso8601(expires)">
                                @UserTime.Format(expires, Model.TimeZoneId, "yyyy/MM/dd")
                            </time>
                        }
                        else
                        {
                            <span class="text-muted">@L["vpn.service.noExpiry"]</span>
                        }
                    </dd>
                </div>
                <div>
                    <dt>@L["vpn.service.devices"]</dt>
                    <dd dir="ltr">@(service.DeviceLimit > 0 ? service.DeviceLimit.ToString() : "—")</dd>
                </div>
            </dl>

            @if (service.UsedPercent is { } percent && !service.IsUnlimitedTraffic)
            {
                <div class="meter" style="margin-block-start:var(--space-4)"
                     role="progressbar"
                     aria-valuenow="@percent" aria-valuemin="0" aria-valuemax="100"
                     aria-label="@L["vpn.service.used"]">
                    <div class="meter__fill @(percent >= 90 ? "meter__fill--danger" : percent >= 75 ? "meter__fill--warning" : null)"
                         style="inline-size:@(percent)%"></div>
                </div>
            }

            @if (link is not null && service.IsUsable)
            {
                @*
                    The subscription URL. Shown only while the service is usable, because a link that
                    will answer 410 is worse than no link at all.

                    Rendered into a value attribute rather than as text so it is never part of the
                    document's selectable flow, and marked readonly so nothing here submits it
                    anywhere. It is a bearer capability: whoever holds it gets the configurations.
                *@
                <div class="field" style="margin-block-start:var(--space-5)">
                    <label class="field__label" for="link-@service.Id">
                        @L["vpn.service.link"]
                    </label>

                    <div class="field__control cluster" dir="ltr">
                        <input id="link-@service.Id"
                               class="input checksum"
                               type="text"
                               value="@link"
                               readonly
                               spellcheck="false"
                               autocomplete="off"
                               aria-describedby="link-hint-@service.Id" />

                        <button type="button"
                                class="btn btn--ghost"
                                data-copy="@link"
                                data-copy-done="@L["vpn.service.link.copied"]"
                                data-copy-failed="@L["vpn.service.link.copyFailed"]">
                            @L["action.copy"]
                        </button>
                    </div>

                    <p class="field__hint" id="link-hint-@service.Id">
                        @L["vpn.service.link.hint"]
                    </p>
                </div>

                <form method="post"
                      asp-area="Vpn"
                      asp-controller="Services"
                      asp-action="RotateLink"
                      asp-route-key="@Model.ProductKey"
                      style="margin-block-start:var(--space-3)">
                    <input type="hidden" name="serviceId" value="@service.Id" />

                    @* The old URL stops working the instant this succeeds, and every device set up
                       with it stops too — so the member is told that before it happens. *@
                    <button type="submit"
                            class="btn btn--ghost btn--sm"
                            data-confirm="@L["vpn.service.link.rotateConfirm"]"
                            data-confirm-title="@L["vpn.service.link.rotate"]"
                            data-confirm-yes="@L["vpn.service.link.rotate"]"
                            data-confirm-no="@L["action.cancel"]">
                        @L["vpn.service.link.rotate"]
                    </button>
                </form>
            }
            else if (link is null && service.HasDeliveryToken)
            {
                @* The row has a link but this process cannot open it — a key ring that moved on.
                   Rotating is the remedy and the member can do it themselves. *@
                <p class="text-xs text-muted" style="margin-block-start:var(--space-4)">
                    @L["vpn.service.link.unreadable"]
                </p>
            }
        </section>
    }

    @foreach (var service in Model.Services)
    {
        var expired = service.IsExpiredAt(now);
        var exhausted = service.IsQuotaExhausted;
        var failed = service.LastFetchStatus is SubscriptionFetchStatus.Failed
            or SubscriptionFetchStatus.Blocked;

        <section class="card">
            <div class="card__header">
                <div style="min-inline-size:0">
                    <h2 class="card__title">@service.Title</h2>
                    <p class="card__hint">@L["vpn.service.external"]</p>
                </div>

                <div class="cluster">
                    @if (!service.IsEnabled)
                    {
                        <span class="badge badge--neutral">@L["admin.application.hidden"]</span>
                    }
                    else if (expired)
                    {
                        <span class="badge badge--danger">@L["appBadge.expired"]</span>
                    }
                    else if (exhausted)
                    {
                        <span class="badge badge--danger">@L["vpn.service.exhausted"]</span>
                    }
                    else if (failed)
                    {
                        <span class="badge badge--warning">@L["vpn.service.unreachable"]</span>
                    }
                    else
                    {
                        <span class="badge badge--success">@L["appBadge.active"]</span>
                    }
                </div>
            </div>

            <dl class="detail-list">
                <div>
                    <dt>@L["vpn.service.used"]</dt>
                    <dd dir="ltr">@Bytes(service.UsedBytes)</dd>
                </div>
                <div>
                    <dt>@L["vpn.service.allowance"]</dt>
                    <dd dir="ltr">
                        @(service.TotalBytes is null or 0 ? L["plan.unlimited"].Value : Bytes(service.TotalBytes))
                    </dd>
                </div>
                <div>
                    <dt>@L["vpn.service.remaining"]</dt>
                    <dd dir="ltr">
                        @(service.TotalBytes is null or 0 ? "—" : Bytes(service.RemainingBytes))
                    </dd>
                </div>
                <div>
                    <dt>@L["vpn.service.expires"]</dt>
                    <dd>
                        @if (service.ExpiresAt is { } expires)
                        {
                            <time datetime="@UserTime.ToIso8601(expires)">
                                @UserTime.Format(expires, Model.TimeZoneId, "yyyy/MM/dd")
                            </time>
                        }
                        else
                        {
                            <span class="text-muted">@L["vpn.service.noExpiry"]</span>
                        }
                    </dd>
                </div>
                <div>
                    <dt>@L["vpn.service.configs"]</dt>
                    <dd dir="ltr">@service.Configs.Count</dd>
                </div>
            </dl>

            @if (service.UsedPercent is { } percent && service.TotalBytes is > 0)
            {
                <div class="meter" style="margin-block-start:var(--space-4)"
                     role="progressbar"
                     aria-valuenow="@percent" aria-valuemin="0" aria-valuemax="100"
                     aria-label="@L["vpn.service.used"]">
                    <div class="meter__fill @(percent >= 90 ? "meter__fill--danger" : percent >= 75 ? "meter__fill--warning" : null)"
                         style="inline-size:@(percent)%"></div>
                </div>
            }

            @if (failed && !string.IsNullOrWhiteSpace(service.LastFetchError))
            {
                @* The stored message is already redacted by the fetcher — it never contains the
                   subscription URL, which is the credential. *@
                <p class="text-xs text-muted bidi" dir="auto" style="margin-block-start:var(--space-3)">
                    @service.LastFetchError
                </p>
            }
        </section>
    }
</div>
