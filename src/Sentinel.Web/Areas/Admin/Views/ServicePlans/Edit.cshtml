@using Sentinel.Vpn.Domain
@model ServicePlanEditViewModel
@{
    ViewData["Title"] = Model.IsNew ? L["admin.plan.add"].Value : Model.NameEn;

    var isPersian = CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "fa";
    var products = ViewData["Products"] as IReadOnlyList<ApplicationListItem> ?? [];
    var statusMessage = TempData["StatusMessage"] as string;

    var errors = ViewData.ModelState
        .SelectMany(entry => entry.Value!.Errors)
        .Select(error => error.ErrorMessage)
        .Where(message => !string.IsNullOrWhiteSpace(message))
        .Distinct()
        .ToList();

    string Localize(string message) =>
        message.StartsWith("validation.", StringComparison.Ordinal)
        || message.StartsWith("admin.", StringComparison.Ordinal)
            ? L[message].Value
            : message;
}

<div class="page-head">
    <h1 class="page-head__title">@ViewData["Title"]</h1>
    <a class="btn btn--ghost btn--sm" asp-action="Index">@L["admin.back"]</a>
</div>

@if (!string.IsNullOrEmpty(statusMessage))
{
    <div class="alert alert--info" role="status" style="margin-block-end:var(--space-6)">
        <span>@statusMessage</span>
    </div>
}

@if (errors.Count > 0)
{
    <div class="alert alert--danger" role="alert" style="margin-block-end:var(--space-6)">
        <div>
            @foreach (var error in errors)
            {
                <div>@Localize(error)</div>
            }
        </div>
    </div>
}

<form method="post"
      asp-action="@(Model.IsNew ? "Create" : "Edit")"
      asp-route-id="@(Model.IsNew ? null : Model.Id.ToString())"
      class="card">
    <input type="hidden" asp-for="ConcurrencyToken" />

    @*
        Three sections, because a plan is three separate decisions: what it is called, what the
        customer gets, and who may buy it. As one flat list of fourteen fields it read as a wall.
    *@
    <div class="form">
        <section class="form-section">
            <div class="form-section__head">
                <h2 class="form-section__title">@L["admin.plan.section.identity"]</h2>
            </div>

            <div class="field">
                <label class="field__label" asp-for="ProductId">@L["admin.plan.product"]</label>
                <select class="input" asp-for="ProductId" required>
                    <option value="">—</option>
                    @foreach (var product in products)
                    {
                        <option value="@product.Id" selected="@(Model.ProductId == product.Id)">
                            @(isPersian ? product.NameFa : product.NameEn)
                        </option>
                    }
                </select>
            </div>

            <div class="form-row form-row--2">
                <div class="field">
                    <label class="field__label" asp-for="NameFa">@L["admin.application.nameFa"]</label>
                    <input class="input" asp-for="NameFa" required maxlength="128" />
                </div>
                <div class="field">
                    <label class="field__label" asp-for="NameEn">@L["admin.application.nameEn"]</label>
                    <input class="input" asp-for="NameEn" dir="ltr" required maxlength="128" />
                </div>
            </div>

            <div class="form-row form-row--3">
                <div class="field">
                    <label class="field__label" asp-for="Key">@L["admin.plan.key"]</label>
                    @if (Model.IsNew)
                    {
                        <input class="input" asp-for="Key" dir="ltr" required maxlength="64"
                               autocomplete="off" spellcheck="false" placeholder="vpn-50gb-monthly" />
                        <p class="field__hint">@L["admin.plan.key.hint"]</p>
                    }
                    else
                    {
                        @* Immutable: the key is in audit rows already written. *@
                        <input class="input" value="@Model.Key" dir="ltr" disabled />
                        <input type="hidden" asp-for="Key" />
                        <p class="field__hint">@L["admin.plan.key.fixed"]</p>
                    }
                </div>

                <div class="field">
                    <label class="field__label" asp-for="CountryCode">@L["admin.plan.country"]</label>
                    <input class="input" asp-for="CountryCode" dir="ltr" maxlength="2"
                           autocapitalize="characters" spellcheck="false"
                           placeholder="@L["admin.plan.country.any"]" />
                    <p class="field__hint">@L["admin.plan.country.hint"]</p>
                </div>

                <div class="field">
                    <label class="field__label" asp-for="DisplayOrder">@L["admin.application.displayOrder"]</label>
                    <input class="input" asp-for="DisplayOrder" type="number" min="0" max="10000" dir="ltr" />
                    <p class="field__hint">@L["admin.plan.displayOrder.hint"]</p>
                </div>
            </div>

            <div class="form-row form-row--2">
                <div class="field">
                    <label class="field__label" asp-for="DescriptionFa">@L["admin.application.descriptionFa"]</label>
                    <textarea class="input" asp-for="DescriptionFa" rows="2" maxlength="1000"></textarea>
                </div>
                <div class="field">
                    <label class="field__label" asp-for="DescriptionEn">@L["admin.application.descriptionEn"]</label>
                    <textarea class="input" asp-for="DescriptionEn" rows="2" maxlength="1000" dir="ltr"></textarea>
                </div>
            </div>
        </section>

        <section class="form-section">
            <div class="form-section__head">
                <h2 class="form-section__title">@L["admin.plan.section.terms"]</h2>
                <p class="form-section__note">@L["admin.plan.section.terms.note"]</p>
            </div>

            <div class="form-row form-row--3">
                <div class="field">
                    <label class="field__label" asp-for="TrafficBytes">@L["admin.plan.traffic"]</label>
                    <input class="input" asp-for="TrafficBytes" type="number" min="0" dir="ltr" />
                    <p class="field__hint">@L["admin.plan.traffic.hint"]</p>
                </div>

                <div class="field">
                    <label class="field__label" asp-for="DurationDays">@L["admin.plan.duration"]</label>
                    <input class="input" asp-for="DurationDays" type="number" min="1" max="3650" dir="ltr" />
                    <p class="field__hint">@L["admin.plan.duration.hint"]</p>
                </div>

                <div class="field">
                    <label class="field__label" asp-for="DeviceLimit">@L["admin.plan.devices"]</label>
                    <input class="input" asp-for="DeviceLimit" type="number" min="0" max="1000" dir="ltr" />
                    <p class="field__hint">@L["admin.plan.devices.hint"]</p>
                </div>
            </div>

            <div class="form-row form-row--lead">
                <div class="field">
                    <label class="field__label" asp-for="PriceMinorUnits">@L["admin.plan.price"]</label>
                    <input class="input" asp-for="PriceMinorUnits" type="number" min="0" dir="ltr" />
                    <p class="field__hint">@L["admin.plan.price.hint"]</p>
                </div>

                <div class="field">
                    <label class="field__label" asp-for="Currency">@L["admin.plan.currency"]</label>
                    <input class="input" asp-for="Currency" dir="ltr" required
                           maxlength="3" minlength="3" autocapitalize="characters" spellcheck="false" />
                    <p class="field__hint">@L["admin.plan.currency.hint"]</p>
                </div>
            </div>
        </section>

        <section class="form-section">
            <div class="form-section__head">
                <h2 class="form-section__title">@L["admin.plan.section.availability"]</h2>
            </div>

            <div class="checkbox-group">
                <div class="checkbox-field">
                    <label class="checkbox">
                        <input type="checkbox" asp-for="IsVisible" />
                        <span>@L["admin.plan.visible"]</span>
                    </label>
                    <p class="field__hint">@L["admin.plan.visible.hint"]</p>
                </div>

                <div class="checkbox-field">
                    <label class="checkbox">
                        <input type="checkbox" asp-for="IsPurchasable" />
                        <span>@L["admin.plan.purchasable"]</span>
                    </label>
                    <p class="field__hint">@L["admin.plan.purchasable.hint"]</p>
                </div>

                <div class="checkbox-field">
                    <label class="checkbox">
                        <input type="checkbox" asp-for="IsFeatured" />
                        <span>@L["admin.plan.featured"]</span>
                    </label>
                    <p class="field__hint">@L["admin.plan.featured.hint"]</p>
                </div>
            </div>
        </section>

        <div class="form-actions">
            <button type="submit" class="btn btn--primary">@L["admin.save"]</button>
            <a class="btn btn--ghost" asp-action="Index">@L["common.cancel"]</a>
        </div>
    </div>
</form>

@* Rules are added and removed one at a time, on their own forms: a plan's audience is the thing
   most worth getting exactly right, and a single big form invites a half-finished save. *@
@if (!Model.IsNew)
{
    <section class="card" style="margin-block-start:var(--space-6)">
        <div class="card__header">
            <div>
                <h2 class="card__title">@L["admin.plan.audience"]</h2>
                <p class="card__hint">@L["admin.plan.audience.hint"]</p>
            </div>
            <span class="badge badge--neutral">@Model.AudienceRules.Count</span>
        </div>

        @if (Model.AudienceRules.Count == 0)
        {
            <p class="text-sm text-muted">@L["admin.plan.audience.open"]</p>
        }
        else
        {
            <ul class="stack stack--tight" style="list-style:none;padding:0;margin:0">
                @foreach (var rule in Model.AudienceRules)
                {
                    <li class="download-row">
                        <div class="download-row__main">
                            <div class="cluster">
                                <span class="badge @(rule.Effect == AudienceEffect.Deny ? "badge--danger" : "badge--success")">
                                    @L[PlanPresentation.EffectKey(rule.Effect)]
                                </span>
                                <strong>@L[PlanPresentation.RuleKindKey(rule.Kind)]</strong>

                                @if (rule.Tier is { } tier)
                                {
                                    <span class="badge badge--neutral badge--plain">@L[AccessPresentation.TierKey(tier)]</span>
                                }
                                @if (!string.IsNullOrWhiteSpace(rule.RoleName))
                                {
                                    <code class="text-xs" dir="ltr">@rule.RoleName</code>
                                }
                                @if (rule.UserId is { } userId)
                                {
                                    <code class="text-xs" dir="ltr">@userId</code>
                                }
                            </div>

                            @if (!string.IsNullOrWhiteSpace(rule.Note))
                            {
                                <p class="text-xs text-muted">@rule.Note</p>
                            }
                        </div>

                        <form method="post" asp-action="RemoveRule"
                              asp-route-id="@Model.Id" asp-route-ruleId="@rule.Id">
                            <button type="submit" class="btn btn--danger btn--sm">@L["admin.delete"]</button>
                        </form>
                    </li>
                }
            </ul>
        }

        <form method="post" asp-action="AddRule" asp-route-id="@Model.Id"
              class="filter-bar" style="margin-block-start:var(--space-5)">
            <div class="field field--inline">
                <label class="field__label" for="rule-effect">@L["admin.plan.audience.effect"]</label>
                <select class="input" id="rule-effect" name="Effect">
                    @foreach (var effect in Enum.GetValues<AudienceEffect>())
                    {
                        <option value="@effect">@L[PlanPresentation.EffectKey(effect)]</option>
                    }
                </select>
            </div>

            <div class="field field--inline">
                <label class="field__label" for="rule-kind">@L["admin.plan.audience.kind"]</label>
                <select class="input" id="rule-kind" name="Kind">
                    @foreach (var kind in Enum.GetValues<AudienceRuleKind>())
                    {
                        <option value="@kind">@L[PlanPresentation.RuleKindKey(kind)]</option>
                    }
                </select>
            </div>

            <div class="field field--inline">
                <label class="field__label" for="rule-tier">@L["admin.plan.audience.tier"]</label>
                <select class="input" id="rule-tier" name="Tier">
                    <option value="">—</option>
                    @foreach (var tier in Enum.GetValues<Sentinel.Domain.Memberships.MembershipTier>())
                    {
                        <option value="@tier">@L[AccessPresentation.TierKey(tier)]</option>
                    }
                </select>
            </div>

            <div class="field field--inline">
                <label class="field__label" for="rule-role">@L["admin.plan.audience.role"]</label>
                <input class="input" id="rule-role" name="RoleName" dir="ltr" maxlength="64" />
            </div>

            <div class="field field--inline">
                <label class="field__label" for="rule-user">@L["admin.plan.audience.user"]</label>
                <input class="input" id="rule-user" name="UserId" dir="ltr" />
            </div>

            <div class="field field--inline">
                <label class="field__label" for="rule-note">@L["admin.plan.audience.note"]</label>
                <input class="input" id="rule-note" name="Note" maxlength="300" />
            </div>

            <button type="submit" class="btn btn--secondary btn--sm">@L["admin.plan.audience.addRule"]</button>
        </form>
    </section>
}
