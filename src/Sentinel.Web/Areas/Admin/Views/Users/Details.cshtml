@model UserDetailViewModel
@{
    var user = Model.User;
    ViewData["Title"] = user.DisplayName;

    var statusBadge = user.Status switch
    {
        UserAccountStatus.Active => "badge--success",
        UserAccountStatus.Suspended => "badge--danger",
        _ => "badge--neutral",
    };

    var membershipEdit = user.MembershipEdit;
    var readOnly = !Model.CanWrite;

    var errors = ViewData.ModelState
        .SelectMany(entry => entry.Value!.Errors)
        .Select(error => error.ErrorMessage)
        .Where(message => !string.IsNullOrWhiteSpace(message))
        .Distinct()
        .ToList();
}

<div class="page-head">
    <div>
        <h1 class="page-head__title">@user.DisplayName</h1>
        <p class="page-head__subtitle mono" dir="ltr">@user.UserName</p>
    </div>
    <div class="cluster">
        <span class="badge @statusBadge">@L[$"status.{user.Status.ToString().ToLowerInvariant()}"]</span>
        <span class="badge @AccessPresentation.MembershipBadgeClass(user.Membership.Status)">
            @L[AccessPresentation.MembershipStatusKey(user.Membership.Status)]
        </span>
        <a class="btn btn--ghost btn--sm" asp-action="Index">@L["admin.back"]</a>
    </div>
</div>

@if (errors.Count > 0)
{
    <div class="alert alert--danger" role="alert" style="margin-block-end:var(--space-6)">
        <div>
            @foreach (var error in errors)
            {
                <div>@error</div>
            }
        </div>
    </div>
}

@if (readOnly)
{
    <div class="alert alert--info" role="status" style="margin-block-end:var(--space-6)">
        <span>@L["admin.readOnlyNotice"]</span>
    </div>
}

<div class="stack" style="gap:var(--space-6)">

    <section class="grid grid--stats">
        <div class="stat">
            <div class="stat__label">@L["account.createdAt"]</div>
            <div class="stat__value" style="font-size:var(--text-md)">
                <time datetime="@UserTime.ToIso8601(user.CreatedAt)">
                    @UserTime.Format(user.CreatedAt, Model.TimeZoneId, "yyyy/MM/dd")
                </time>
            </div>
        </div>
        <div class="stat">
            <div class="stat__label">@L["account.lastLogin"]</div>
            <div class="stat__value" style="font-size:var(--text-md)">
                @if (user.LastLoginAt is { } lastLogin)
                {
                    <time datetime="@UserTime.ToIso8601(lastLogin)">
                        @UserTime.Format(lastLogin, Model.TimeZoneId)
                    </time>
                }
                else
                {
                    @L["account.never"]
                }
            </div>
        </div>
        <div class="stat">
            <div class="stat__label">@L["security.activeSessions"]</div>
            <div class="stat__value">@user.ActiveSessionCount</div>
        </div>
        <div class="stat">
            <div class="stat__label">@L["admin.user.lockout"]</div>
            <div class="stat__value" style="font-size:var(--text-md)">
                @if (user.LockoutActive && user.LockoutEnd is { } lockoutEnd)
                {
                    <span class="badge badge--danger">@UserTime.Format(lockoutEnd, Model.TimeZoneId)</span>
                }
                else
                {
                    <span class="text-muted">@L["admin.user.lockout.none"]</span>
                }
            </div>
            <div class="stat__meta">@L["admin.user.failedAttempts", user.AccessFailedCount]</div>
        </div>
    </section>

    <div class="grid" style="grid-template-columns:repeat(auto-fit,minmax(min(100%,360px),1fr))">

        @* ------------------------------------------------------------------- profile ---- *@
        <section class="card">
            <div class="card__header">
                <h2 class="card__title">@L["admin.user.profile"]</h2>
            </div>

            <form method="post" asp-action="UpdateProfile" class="stack">
                <input type="hidden" name="UserId" value="@user.Id" />

                <div class="field">
                    <label class="field__label" for="DisplayName">@L["admin.user.displayName"]</label>
                    <input id="DisplayName" name="DisplayName" class="input" required maxlength="128"
                           value="@user.DisplayName" disabled="@readOnly" />
                </div>

                <div class="field">
                    <label class="field__label" for="Email">@L["admin.user.email"]</label>
                    <input id="Email" name="Email" class="input" type="email" required maxlength="256"
                           dir="ltr" value="@user.Email" disabled="@readOnly" />
                </div>

                <div class="field">
                    <label class="field__label" for="PhoneNumber">@L["admin.user.phone"]</label>
                    <input id="PhoneNumber" name="PhoneNumber" class="input" maxlength="32"
                           dir="ltr" value="@user.PhoneNumber" disabled="@readOnly"
                           placeholder="09121234567" />
                    <p class="text-xs text-muted">@L["admin.user.phone.hint"]</p>
                </div>

                <div class="grid" style="grid-template-columns:1fr 1fr">
                    <div class="field">
                        <label class="field__label" for="PreferredCulture">@L["admin.user.culture"]</label>
                        <select id="PreferredCulture" name="PreferredCulture" class="input" disabled="@readOnly">
                            <option value="fa" selected="@(user.PreferredCulture == "fa")">@L["language.persian"]</option>
                            <option value="en" selected="@(user.PreferredCulture == "en")">@L["language.english"]</option>
                        </select>
                    </div>
                    <div class="field">
                        <label class="field__label" for="TimeZoneId">@L["admin.user.timeZone"]</label>
                        <input id="TimeZoneId" name="TimeZoneId" class="input" maxlength="64"
                               dir="ltr" value="@user.TimeZoneId" disabled="@readOnly" />
                    </div>
                </div>

                @if (!readOnly)
                {
                    <button type="submit" class="btn btn--primary">@L["admin.save"]</button>
                }
            </form>
        </section>

        @* -------------------------------------------------------------------- status ---- *@
        <section class="card">
            <div class="card__header">
                <div>
                    <h2 class="card__title">@L["admin.user.accountStatus"]</h2>
                    <p class="card__hint">@L["admin.user.accountStatus.hint"]</p>
                </div>
            </div>

            <form method="post" asp-action="ChangeStatus" class="stack">
                <input type="hidden" name="UserId" value="@user.Id" />

                <div class="field">
                    <label class="field__label" for="Status">@L["admin.user.status"]</label>
                    <select id="Status" name="Status" class="input" disabled="@(readOnly || Model.IsSelf)">
                        @foreach (var status in Enum.GetValues<UserAccountStatus>())
                        {
                            <option value="@status" selected="@(user.Status == status)">
                                @L[$"status.{status.ToString().ToLowerInvariant()}"]
                            </option>
                        }
                    </select>
                </div>

                <div class="field">
                    <label class="field__label" for="SuspendedUntil">@L["admin.user.suspendedUntil"]</label>
                    <input id="SuspendedUntil" name="SuspendedUntil" class="input" type="date"
                           dir="ltr" disabled="@(readOnly || Model.IsSelf)"
                           value="@(user.SuspendedUntil?.UtcDateTime.ToString("yyyy-MM-dd"))" />
                    <p class="text-xs text-muted">@L["admin.user.suspendedUntil.hint"]</p>
                </div>

                <div class="field">
                    <label class="field__label" for="Note">@L["admin.user.statusNote"]</label>
                    <textarea id="Note" name="Note" class="input" rows="2" maxlength="512"
                              style="min-block-size:auto;padding-block:var(--space-3)"
                              disabled="@(readOnly || Model.IsSelf)">@user.StatusNote</textarea>
                    <p class="text-xs text-muted">@L["admin.user.statusNote.hint"]</p>
                </div>

                @if (Model.IsSelf)
                {
                    @* An administrator disabling their own account would lock themselves out of
                       the only place the change could be undone. The server refuses it too. *@
                    <div class="alert alert--info" role="status">
                        <span>@L["admin.user.selfStatusNotice"]</span>
                    </div>
                }
                else if (!readOnly)
                {
                    <button type="submit" class="btn btn--primary"
                            data-confirm="@L["admin.user.status.confirmBody"]"
                            data-confirm-title="@L["admin.user.status.confirmTitle"]"
                            data-confirm-yes="@L["common.confirm"]"
                            data-confirm-no="@L["common.cancel"]">
                        @L["admin.save"]
                    </button>
                }
            </form>
        </section>
    </div>

    @* --------------------------------------------------------------------- membership ---- *@
    <section class="card">
        <div class="card__header">
            <div>
                <h2 class="card__title">@L["admin.membership.title"]</h2>
                <p class="card__hint">@L["admin.membership.hint"]</p>
            </div>
        </div>

        <form method="post" asp-action="SaveMembership" class="stack"
              id="membership-form"
              data-preview-url="@Url.Action("PreviewMembership")">
            <input type="hidden" name="UserId" value="@user.Id" />
            <input type="hidden" name="ConcurrencyToken" value="@membershipEdit?.ConcurrencyToken" />

            <div class="grid" style="grid-template-columns:repeat(auto-fit,minmax(min(100%,180px),1fr))">
                <div class="field">
                    <label class="field__label" for="Tier">@L["admin.membership.tier"]</label>
                    <select id="Tier" name="Tier" class="input" disabled="@readOnly">
                        @foreach (var tier in Enum.GetValues<MembershipTier>())
                        {
                            <option value="@tier" selected="@(membershipEdit?.Tier == tier)">
                                @L[AccessPresentation.TierKey(tier)]
                            </option>
                        }
                    </select>
                </div>

                <div class="field">
                    <label class="field__label" for="AdminState">@L["admin.membership.adminState"]</label>
                    <select id="AdminState" name="AdminState" class="input" disabled="@readOnly">
                        @foreach (var state in Enum.GetValues<MembershipAdminState>())
                        {
                            <option value="@state" selected="@(membershipEdit?.AdminState == state)">
                                @L[$"membershipState.{state.ToString().ToLowerInvariant()}"]
                            </option>
                        }
                    </select>
                </div>

                <div class="field">
                    <label class="field__label" for="StartsAt">@L["admin.membership.startsAt"]</label>
                    <input id="StartsAt" name="StartsAt" class="input" type="date" dir="ltr" required
                           disabled="@readOnly"
                           value="@((membershipEdit?.StartsAt ?? DateTimeOffset.UtcNow).UtcDateTime.ToString("yyyy-MM-dd"))" />
                </div>

                <div class="field">
                    <label class="field__label" for="EndsAt">@L["admin.membership.endsAt"]</label>
                    <input id="EndsAt" name="EndsAt" class="input" type="date" dir="ltr"
                           disabled="@readOnly"
                           value="@(membershipEdit?.EndsAt?.UtcDateTime.ToString("yyyy-MM-dd"))" />
                    <p class="text-xs text-muted">@L["admin.membership.endsAt.hint"]</p>
                </div>

                <div class="field">
                    <label class="field__label" for="GracePeriodDaysOverride">
                        @L["admin.membership.graceOverride"]
                    </label>
                    <input id="GracePeriodDaysOverride" name="GracePeriodDaysOverride" class="input"
                           type="number" min="0" max="90" dir="ltr" disabled="@readOnly"
                           value="@membershipEdit?.GracePeriodDaysOverride" />
                    <p class="text-xs text-muted">@L["admin.membership.graceOverride.hint"]</p>
                </div>
            </div>

            <div class="field">
                <label class="field__label" for="Notes">@L["admin.membership.notes"]</label>
                <textarea id="Notes" name="Notes" class="input" rows="2" maxlength="1024"
                          style="min-block-size:auto;padding-block:var(--space-3)"
                          disabled="@readOnly">@membershipEdit?.Notes</textarea>
            </div>

            @* Live preview. It calls the server, which runs the same resolver the portal uses,
               so what this promises and what members experience cannot drift apart. *@
            <div id="membership-preview"
                 data-labels="@IslandPayload.Serialize(new {
                                   heading = L["admin.membership.preview"].Value,
                                   grantsAccess = L["admin.membership.preview.grants"].Value,
                                   noAccess = L["admin.membership.preview.noAccess"].Value,
                                   daysRemaining = L["membership.daysRemaining"].Value,
                                   accessUntil = L["admin.membership.preview.accessUntil"].Value,
                                   failed = L["admin.membership.preview.failed"].Value
                               })"></div>

            @if (!readOnly)
            {
                <div>
                    <button type="submit" class="btn btn--primary">@L["admin.membership.save"]</button>
                </div>
            }
        </form>
    </section>

    @* -------------------------------------------------------------------------- roles ---- *@
    <section class="card">
        <div class="card__header">
            <div>
                <h2 class="card__title">@L["admin.user.roles"]</h2>
                <p class="card__hint">@L["admin.user.roles.hint"]</p>
            </div>
        </div>

        @if (Model.CanManageRoles)
        {
            <form method="post" asp-action="SetRoles" class="stack">
                <input type="hidden" name="UserId" value="@user.Id" />

                <div class="cluster" style="gap:var(--space-4)">
                    @foreach (var role in RoleNames.All)
                    {
                        <label class="checkbox">
                            <input type="checkbox" name="Roles" value="@role"
                                   checked="@user.Roles.Contains(role)" />
                            <span>@L[$"role.{role}"]</span>
                        </label>
                    }
                </div>

                <div>
                    <button type="submit" class="btn btn--primary"
                            data-confirm="@L["admin.user.roles.confirmBody"]"
                            data-confirm-title="@L["admin.user.roles.confirmTitle"]"
                            data-confirm-yes="@L["common.confirm"]"
                            data-confirm-no="@L["common.cancel"]">
                        @L["admin.save"]
                    </button>
                </div>
            </form>
        }
        else
        {
            <div class="cluster">
                @foreach (var role in user.Roles)
                {
                    <span class="badge badge--accent badge--plain">@L[$"role.{role}"]</span>
                }
            </div>
            <p class="text-xs text-muted" style="margin-block-start:var(--space-3)">
                @L["admin.user.roles.superAdminOnly"]
            </p>
        }
    </section>

    @* ------------------------------------------------------------------ subscriptions ---- *@
    @if (Model.CanWrite)
    {
        <section class="card">
            <div class="card__header">
                <div>
                    <h2 class="card__title">@L["admin.subscriptions.addForUser"]</h2>
                    <p class="card__hint">@L["configs.add.hint"]</p>
                </div>
                <a class="btn btn--outline btn--sm"
                   asp-area="Admin" asp-controller="Subscriptions" asp-action="Index"
                   asp-route-search="@user.UserName">
                    @L["admin.subscriptions.forUser"]
                </a>
            </div>

            <form method="post" asp-area="Admin" asp-controller="Subscriptions" asp-action="AddForUser"
                  class="stack">
                <input type="hidden" name="UserId" value="@user.Id" />

                <div class="grid" style="grid-template-columns:1fr 2fr;gap:var(--space-3)">
                    <div class="field">
                        <label class="field__label" for="sub-title">@L["configs.add.label"]</label>
                        <input id="sub-title" name="Title" class="input" maxlength="120"
                               placeholder="@L["configs.add.labelPlaceholder"]" />
                    </div>

                    <div class="field">
                        <label class="field__label" for="sub-url">@L["configs.add.url"]</label>
                        <input id="sub-url" name="Url" class="input" type="url" dir="ltr" required
                               maxlength="2048" placeholder="https://…" autocomplete="off" />
                    </div>
                </div>

                <div>
                    <button type="submit" class="btn btn--primary btn--sm">@L["configs.add.submit"]</button>
                </div>
            </form>
        </section>
    }

    @* ----------------------------------------------------------------------- message ---- *@
    @if (Model.CanWrite)
    {
        <section class="card">
            <div class="card__header">
                <div>
                    <h2 class="card__title">@L["admin.messages.sendTo", user.DisplayName]</h2>
                    <p class="card__hint">@L["admin.messages.sendTo.hint"]</p>
                </div>
            </div>

            <form method="post" asp-area="Admin" asp-controller="Messages" asp-action="SendToUser"
                  class="stack">
                <input type="hidden" name="UserId" value="@user.Id" />

                <div class="field">
                    <label class="field__label" for="message-title">@L["admin.messages.subject"]</label>
                    <input id="message-title" name="Title" class="input" required maxlength="200" />
                </div>

                <div class="field">
                    <label class="field__label" for="message-body">@L["admin.messages.body"]</label>
                    <textarea id="message-body" name="Body" class="input" rows="4" required
                              maxlength="2000"
                              style="min-block-size:auto;padding-block:var(--space-3)"></textarea>
                </div>

                <label class="checkbox">
                    <input type="checkbox" name="DeliverToTelegram" value="true" checked />
                    <span>@L["admin.messages.deliverToTelegram"]</span>
                </label>

                <div>
                    <button type="submit" class="btn btn--primary btn--sm">@L["admin.messages.send"]</button>
                </div>
            </form>
        </section>
    }

    @* ------------------------------------------------------------------- entitlements ---- *@
    <section class="card card--flush">
        <div style="padding:var(--space-6) var(--space-6) var(--space-4)">
            <div class="cluster" style="justify-content:space-between">
                <div>
                    <h2 class="card__title">@L["admin.user.entitlements"]</h2>
                    <p class="card__hint">@L["admin.user.entitlements.hint"]</p>
                </div>
                <a class="btn btn--outline btn--sm" asp-action="Entitlements" asp-route-id="@user.Id">
                    @L["admin.user.entitlements.manage"]
                </a>
            </div>
        </div>

        @if (user.Entitlements.Count == 0)
        {
            <div class="empty-state">
                <p class="empty-state__title">@L["admin.user.entitlements.empty.title"]</p>
                <p class="empty-state__body">@L["admin.user.entitlements.empty.body"]</p>
            </div>
        }
        else
        {
            <div class="table-scroll">
                <table class="table">
                    <thead>
                    <tr>
                        <th scope="col">@L["membership.table.application"]</th>
                        <th scope="col">@L["admin.entitlement.state"]</th>
                        <th scope="col">@L["admin.entitlement.starts"]</th>
                        <th scope="col">@L["admin.entitlement.expires"]</th>
                        <th scope="col">@L["admin.membership.notes"]</th>
                    </tr>
                    </thead>
                    <tbody>
                    @foreach (var entitlement in user.Entitlements)
                    {
                        <tr>
                            <td>
                                <div>@entitlement.ApplicationName</div>
                                <div class="mono text-xs text-muted" dir="ltr">@entitlement.ApplicationKey</div>
                            </td>
                            <td>
                                @if (entitlement.RevokedAt is not null)
                                {
                                    <span class="badge badge--danger">@L["admin.entitlement.revoked"]</span>
                                }
                                else if (!entitlement.IsEnabled)
                                {
                                    <span class="badge badge--neutral">@L["admin.entitlement.disabled"]</span>
                                }
                                else
                                {
                                    <span class="badge badge--success">@L["admin.entitlement.active"]</span>
                                }
                            </td>
                            <td class="table__numeric text-sm">
                                @UserTime.Format(entitlement.StartsAt, Model.TimeZoneId, "yyyy/MM/dd")
                            </td>
                            <td class="table__numeric text-sm">
                                @(entitlement.ExpiresAt is { } expires
                                    ? UserTime.Format(expires, Model.TimeZoneId, "yyyy/MM/dd")
                                    : "—")
                            </td>
                            <td class="text-sm text-secondary">@(entitlement.Notes ?? "—")</td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        }
    </section>

    @* ------------------------------------------------------------------ login history ---- *@
    <section class="card card--flush">
        <div style="padding:var(--space-6) var(--space-6) var(--space-4)">
            <h2 class="card__title">@L["loginHistory.title"]</h2>
        </div>

        @if (user.RecentLoginAttempts.Count == 0)
        {
            <div class="empty-state">
                <p class="empty-state__title">@L["loginHistory.empty.title"]</p>
            </div>
        }
        else
        {
            <div class="table-scroll">
                <table class="table">
                    <thead>
                    <tr>
                        <th scope="col">@L["loginHistory.time"]</th>
                        <th scope="col">@L["loginHistory.result"]</th>
                        <th scope="col">@L["admin.loginHistory.reason"]</th>
                        <th scope="col">@L["loginHistory.ip"]</th>
                    </tr>
                    </thead>
                    <tbody>
                    @foreach (var attempt in user.RecentLoginAttempts)
                    {
                        <tr>
                            <td class="table__numeric text-sm">
                                <time datetime="@UserTime.ToIso8601(attempt.OccurredAt)">
                                    @UserTime.Format(attempt.OccurredAt, Model.TimeZoneId)
                                </time>
                            </td>
                            <td>
                                @if (attempt.Succeeded)
                                {
                                    <span class="badge badge--success">@L["loginHistory.success"]</span>
                                }
                                else
                                {
                                    <span class="badge badge--danger">@L["loginHistory.failure"]</span>
                                }
                            </td>
                            @* The precise reason is shown here but never to the member: to an
                               operator it is diagnostic, on the login form it would be an oracle. *@
                            <td class="text-sm text-secondary">
                                @(attempt.Succeeded ? "—" : L[$"loginFailure.{attempt.FailureReason}"].Value)
                            </td>
                            <td class="mono text-xs" dir="ltr">@(attempt.IpAddress ?? "—")</td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        }
    </section>
</div>

@section Scripts {
    <script type="module" src="~/js/dist/page-membership-editor.js" asp-append-version="true"></script>
}
