@model CreateUserViewModel
@{
    ViewData["Title"] = L["admin.users.create"].Value;

    var errors = ViewData.ModelState
        .SelectMany(entry => entry.Value!.Errors)
        .Select(error => error.ErrorMessage)
        .Where(message => !string.IsNullOrWhiteSpace(message))
        .Distinct()
        .ToList();
}

<div class="page-head">
    <div>
        <h1 class="page-head__title">@L["admin.users.create"]</h1>
        <p class="page-head__subtitle">@L["admin.users.create.subtitle"]</p>
    </div>
    <a class="btn btn--ghost btn--sm" asp-action="Index">@L["admin.back"]</a>
</div>

@if (errors.Count > 0)
{
    <div class="alert alert--danger" role="alert" style="margin-block-end:var(--space-6)">
        <div>
            @foreach (var error in errors)
            {
                @* Model errors carry localisation keys; anything already resolved passes through. *@
                <div>@(error.StartsWith("validation.", StringComparison.Ordinal)
                        || error.StartsWith("admin.", StringComparison.Ordinal)
                        ? L[error].Value
                        : error)</div>
            }
        </div>
    </div>
}

<form method="post" class="card" style="max-inline-size:720px">
    <div class="stack">
        @* Two pairs rather than one row of four: who the account is, then how to reach them. *@
        <div class="form-row form-row--2">
            <div class="field">
                <label class="field__label" asp-for="UserName">@L["admin.user.userName"]</label>
                <input class="input" asp-for="UserName" dir="ltr" required maxlength="64"
                       autocomplete="off" autocapitalize="none" spellcheck="false" />
                <p class="field__hint">@L["admin.user.userName.hint"]</p>
            </div>

            <div class="field">
                <label class="field__label" asp-for="DisplayName">@L["admin.user.displayName"]</label>
                <input class="input" asp-for="DisplayName" required maxlength="128" />
            </div>
        </div>

        <div class="form-row form-row--2">
            <div class="field">
                <label class="field__label" asp-for="Email">@L["admin.user.email"]</label>
                <input class="input" asp-for="Email" type="email" dir="ltr" required maxlength="256"
                       autocomplete="off" />
            </div>

            <div class="field">
                <label class="field__label" asp-for="PhoneNumber">@L["admin.user.phone"]</label>
                <input class="input" asp-for="PhoneNumber" dir="ltr" maxlength="32"
                       autocomplete="off" placeholder="09121234567" />
                <p class="field__hint">@L["admin.user.phone.hint"]</p>
            </div>
        </div>

        <div class="divider"></div>

        <div class="form-row">
            <div class="field">
                <label class="field__label" asp-for="Password">@L["admin.user.password"]</label>
                <input class="input" asp-for="Password" type="password" dir="ltr" required
                       maxlength="256" autocomplete="new-password" />
                <p class="field__hint">@L["admin.user.password.hint"]</p>
            </div>

            <div class="field">
                <label class="field__label" asp-for="ConfirmPassword">@L["admin.user.passwordConfirm"]</label>
                <input class="input" asp-for="ConfirmPassword" type="password" dir="ltr" required
                       maxlength="256" autocomplete="new-password" />
            </div>
        </div>

        <div class="divider"></div>

        <div class="field">
            <span class="field__label">@L["admin.user.roles"]</span>
            <div class="cluster" style="gap:var(--space-4)">
                @foreach (var role in RoleNames.All)
                {
                    <label class="checkbox">
                        <input type="checkbox" name="Roles" value="@role"
                               checked="@Model.Roles.Contains(role)" />
                        <span>@L[$"role.{role}"]</span>
                    </label>
                }
            </div>
            <p class="field__hint">@L["admin.user.roles.createHint"]</p>
        </div>

        <div class="form-row form-row--2">
            <div class="field">
                <label class="field__label" asp-for="PreferredCulture">@L["admin.user.culture"]</label>
                <select class="input" asp-for="PreferredCulture">
                    <option value="fa">@L["language.persian"]</option>
                    <option value="en">@L["language.english"]</option>
                </select>
            </div>

            <div class="field">
                <label class="field__label" asp-for="TimeZoneId">@L["admin.user.timeZone"]</label>
                <input class="input" asp-for="TimeZoneId" dir="ltr" maxlength="64" />
            </div>
        </div>

        <div class="form-actions">
            <button type="submit" class="btn btn--primary">@L["admin.users.create"]</button>
            <a class="btn btn--ghost" asp-action="Index">@L["common.cancel"]</a>
        </div>
    </div>
</form>
