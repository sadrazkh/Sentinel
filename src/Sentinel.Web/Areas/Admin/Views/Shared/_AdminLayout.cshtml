@using System.Globalization
@{
    var culture = CultureInfo.CurrentUICulture;
    var direction = PortalCultures.DirectionAttribute(culture);
    var nonce = ContentSecurityPolicyNonce.GetOrCreate(Context);
    var currentPath = $"{Context.Request.Path}{Context.Request.QueryString}";
    var isPersian = culture.TwoLetterISOLanguageName == "fa";
    var otherCulture = isPersian ? PortalCultures.English : PortalCultures.Persian;
    var otherCultureLabel = isPersian ? L["language.english"] : L["language.persian"];
    var statusMessage = TempData["StatusMessage"] as string;
}
<!DOCTYPE html>
<html lang="@culture.TwoLetterISOLanguageName" dir="@direction">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    <title>@(ViewData["Title"] ?? L["admin.title"].Value) · @L["admin.title"]</title>
    <link rel="icon" href="~/favicon.svg" type="image/svg+xml" />
    <link rel="stylesheet" href="~/css/sentinel.css" asp-append-version="true" />

    <script nonce="@nonce">
        (function () {
            try {
                var stored = window.localStorage.getItem('sentinel.theme');
                if (stored === 'light' || stored === 'dark') {
                    document.documentElement.setAttribute('data-theme', stored);
                }
            } catch (e) { /* storage blocked; fall back to the OS preference */ }
        })();
    </script>
</head>
<body>
<a class="visually-hidden" href="#main-content">@L["nav.skipToContent"]</a>

<div class="app-shell">
    <header class="app-header">
        <a class="brand" asp-area="" asp-controller="Dashboard" asp-action="Index">
            <span class="brand__mark" aria-hidden="true">
                <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                     stroke-width="2.1" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M12 2.5 4.5 5.8v5.4c0 4.6 3.2 8.9 7.5 10.3 4.3-1.4 7.5-5.7 7.5-10.3V5.8z" />
                    <path d="m9.2 12.1 2 2 3.6-3.9" />
                </svg>
            </span>
            <span class="brand__label">@L["app.name"]</span>
        </a>

        <span class="badge badge--accent badge--plain">@L["admin.title"]</span>

        <nav class="cluster" aria-label="@L["admin.nav"]">
            <a class="btn btn--ghost btn--sm" asp-area="Admin" asp-controller="Users" asp-action="Index">
                @L["admin.nav.users"]
            </a>
            <a class="btn btn--ghost btn--sm" asp-area="Admin" asp-controller="Applications" asp-action="Index">
                @L["admin.nav.applications"]
            </a>
            <a class="btn btn--ghost btn--sm" asp-area="Admin" asp-controller="Audit" asp-action="Index">
                @L["admin.nav.audit"]
            </a>
            @if (User.IsInRole(RoleNames.SuperAdmin) || User.IsInRole(RoleNames.Admin))
            {
                <a class="btn btn--ghost btn--sm" asp-area="Admin" asp-controller="Messages" asp-action="Broadcast">
                    @L["admin.nav.messages"]
                </a>
            }
            @if (User.IsInRole(RoleNames.SuperAdmin))
            {
                @* Shown by role for convenience; the controller's policy is what enforces it. *@
                <a class="btn btn--ghost btn--sm" asp-area="Admin" asp-controller="System" asp-action="Index">
                    @L["admin.nav.system"]
                </a>
            }
        </nav>

        <span class="header-spacer"></span>

        <div class="header-actions">
            <button type="button"
                    class="btn btn--icon"
                    data-theme-toggle
                    data-label-light="@L["theme.light"]"
                    data-label-dark="@L["theme.dark"]"
                    data-label-auto="@L["theme.auto"]"
                    aria-label="@L["theme.toggle"]"
                    title="@L["theme.toggle"]">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                     stroke-width="1.8" stroke-linecap="round" aria-hidden="true">
                    <path d="M12 3v1.6M12 19.4V21M4.2 12H3M21 12h-1.2M5.9 5.9 5 5M19 19l-.9-.9M18.1 5.9l.9-.9M5 19l.9-.9" />
                    <circle cx="12" cy="12" r="4" />
                </svg>
            </button>

            <form method="post" asp-area="" asp-controller="Home" asp-action="SetLanguage">
                <input type="hidden" name="culture" value="@otherCulture" />
                <input type="hidden" name="returnUrl" value="@currentPath" />
                <button type="submit" class="btn btn--ghost btn--sm" title="@L["language.switch"]">
                    @otherCultureLabel
                </button>
            </form>

            <a class="btn btn--ghost btn--sm" asp-area="" asp-controller="Dashboard" asp-action="Index">
                @L["admin.backToPortal"]
            </a>

            <form method="post" asp-area="" asp-controller="Account" asp-action="Logout">
                <button type="submit" class="btn btn--ghost btn--sm">@L["nav.signOut"]</button>
            </form>
        </div>
    </header>

    <main class="app-main" id="main-content" style="max-width:1440px">
        @if (!string.IsNullOrEmpty(statusMessage))
        {
            <div class="alert alert--success" role="status" style="margin-block-end:var(--space-6)">
                <span>@statusMessage</span>
            </div>
        }

        @RenderBody()
    </main>

    <footer class="app-footer">
        @L["app.name"] · @L["admin.title"]
    </footer>
</div>

<script type="module" src="~/js/dist/site.js" asp-append-version="true"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
