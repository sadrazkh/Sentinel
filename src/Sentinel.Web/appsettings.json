{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning",
        "Microsoft.EntityFrameworkCore.Infrastructure": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "formatter": "Serilog.Formatting.Compact.CompactJsonFormatter, Serilog.Formatting.Compact"
        }
      }
    ]
  },

  "AllowedHosts": "*",

  "ConnectionStrings": {
    "Sentinel": ""
  },

  "Database": {
    "Provider": "PostgreSql",
    "ConnectionString": "",
    "MigrateOnStartup": false,
    "CommandTimeoutSeconds": 30,
    "EnableSensitiveDataLogging": false
  },

  "Security": {
    "RequireHttps": true,
    "SessionLifetimeMinutes": 480,
    "SlidingExpiration": true,
    "ForwardedHeaderHops": 0,
    "Password": {
      "MinimumLength": 12,
      "RequiredUniqueChars": 5,
      "RequireDigit": true,
      "RequireLowercase": true,
      "RequireUppercase": false,
      "RequireNonAlphanumeric": false
    },
    "Lockout": {
      "MaxFailedAttempts": 5,
      "LockoutMinutes": 15
    },
    "LoginRateLimit": {
      "PermitLimit": 10,
      "WindowSeconds": 60,
      "QueueLimit": 0
    }
  },

  "SecurityHeaders": {
    "ContentSecurityPolicyReportOnly": false,
    "ContentSecurityPolicyReportUri": null,
    "UpgradeInsecureRequests": true
  },

  "Membership": {
    "GracePeriodDays": 3,
    "RenewalWarningDays": 7
  },

  "Features": {
    "ProductLibraryEnabled": true,
    "ProductDiscoveryEnabled": true,
    "ProductDocumentationEnabled": true,
    "BetaProductsEnabled": true,
    "ExternalSubscriptionsEnabled": true,

    "VpnSelfServiceEnabled": false,
    "PurchasesEnabled": false,
    "PaymentsEnabled": false,
    "WalletEnabled": false
  },

  "Seed": {
    "SuperAdmin": {
      "Enabled": false,
      "UserName": "",
      "Email": "",
      "DisplayName": "System Administrator",
      "Password": ""
    },
    "IncludeSampleApplications": false
  },

  "Vpn": {
    "Panel": {
      "TimeoutSeconds": 15,
      "MaxResponseBytes": 2097152,
      "HealthCheckIntervalMinutes": 5,

      "AllowInsecurePanelUrls": false,
      "AllowLoopbackPanelUrls": false
    },

    "Provisioning": {
      "Enabled": true,
      "JobIntervalSeconds": 20,
      "JobBatchSize": 10,
      "UsageIntervalMinutes": 15,
      "UsageBatchSize": 50,
      "ReconcileIntervalMinutes": 5,
      "ReconcileBatchSize": 20,
      "MigrationIntervalSeconds": 30,
      "MigrationBatchSize": 5,
      "StartupDelaySeconds": 25
    }
  },

  "Telegram": {
    "Enabled": false,
    "BotToken": "",
    "BotUsername": "",
    "PublicBaseUrl": "",
    "UsePolling": true,
    "DeliveryIntervalSeconds": 15,
    "DeliveryBatchSize": 20
  },

  "ExpiryNotices": {
    "Enabled": true,
    "IntervalMinutes": 60,
    "StartupDelaySeconds": 30,
    "BatchSize": 200,
    "SubscriptionWarningDays": 7,
    "QuotaWarningPercent": 85
  },

  "Subscriptions": {
    "Enabled": true,
    "TimeoutSeconds": 15,
    "MaxResponseBytes": 524288,
    "MaxRedirects": 3,
    "CacheMinutes": 15,
    "MaxSourcesPerUser": 10,
    "UserAgent": "v2rayNG/1.8.29"
  },

  "MediaStorage": {
    "RootPath": "media",
    "MaxIconBytes": 524288
  },

  "DataProtection": {
    "KeyRingPath": ""
  }
}
