@using Sentinel.Domain.Subscriptions
@using Sentinel.Web.Models.Configs
@model ConfigsViewModel
@{
    ViewData["Title"] = L["configs.title"].Value;
    var statusMessage = TempData["StatusMessage"] as string;
    var now = DateTimeOffset.UtcNow;
    var labels = IslandPayload.Serialize(ConfigGridLabels.From(L));

    static string FormatBytes(long? bytes) =>
        bytes is null ? "—" : bytes switch
        {
            < 1024 => $"{bytes} B",
            < 1024L * 1024 => $"{bytes / 1024.0:0.#} KB",
            < 1024L * 1024 * 1024 => $"{bytes / (1024.0 * 1024):0.#} MB",
            _ => $"{bytes / (1024.0 * 1024 * 1024):0.##} GB",
        };
}

<div class="page-head">
    <div>
        <h1 class="page-head__title">@L["configs.title"]</h1>
        <p class="page-head__subtitle">@L["configs.subtitle"]</p>
    </div>
    @if (Model.TotalConfigs > 0)
    {
        <span class="badge badge--success">@L["configs.count", Model.TotalConfigs]</span>
    }
</div>

@if (!string.IsNullOrEmpty(statusMessage))
{
    <div class="alert alert--info" role="status" style="margin-block-end:var(--space-6)">
        <span>@statusMessage</span>
    </div>
}

<div class="stack" style="gap:var(--space-6)">

    @if (Model.Subscriptions.Count == 0)
    {
        <div class="card">
            <div class="empty-state">
                <div class="empty-state__icon" aria-hidden="true">
                    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                         stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M4 7.5h16M4 12h16M4 16.5h10" />
                    </svg>
                </div>
                <p class="empty-state__title">@L["configs.empty.title"]</p>
                <p class="empty-state__body">@L["configs.empty.body"]</p>
            </div>
        </div>
    }

    @foreach (var subscription in Model.Subscriptions)
    {
        var isExpired = subscription.IsExpiredAt(now);
        var isExhausted = subscription.IsQuotaExhausted;
        var failed = subscription.LastFetchStatus is SubscriptionFetchStatus.Failed
            or SubscriptionFetchStatus.Blocked;

        var payload = IslandPayload.Serialize(
            subscription.Configs.Select(ConfigPayload.From).ToList());

        <section class="card">
            <div class="card__header">
                <div style="min-inline-size:0">
                    <h2 class="card__title">@subscription.Title</h2>
                    <p class="card__hint">
                        @if (subscription.LastFetchedAt is { } fetchedAt)
                        {
                            <span>
                                @L["configs.lastChecked",
                                    UserTime.Format(fetchedAt, Model.TimeZoneId)]
                            </span>
                        }
                        else
                        {
                            <span>@L["configs.neverChecked"]</span>
                        }
                    </p>
                </div>

                <div class="cluster">
                    @if (isExpired)
                    {
                        <span class="badge badge--danger">@L["configs.expired"]</span>
                    }
                    else if (isExhausted)
                    {
                        <span class="badge badge--danger">@L["configs.exhausted"]</span>
                    }
                    else if (failed)
                    {
                        <span class="badge badge--warning">@L["configs.unavailable"]</span>
                    }
                    else if (subscription.Configs.Count > 0)
                    {
                        <span class="badge badge--success">@L["configs.active"]</span>
                    }
                </div>
            </div>

            <div class="stack">
                @* ------------------------------------------------------ quota and expiry ---- *@
                @if (subscription.TotalBytes is not null || subscription.ExpiresAt is not null)
                {
                    <div class="grid grid--stats" style="gap:var(--space-3)">
                        @if (subscription.TotalBytes is { } total)
                        {
                            var percent = subscription.UsedPercent ?? 0;
                            var fillClass = percent >= 90
                                ? "meter__fill meter__fill--danger"
                                : percent >= 70
                                    ? "meter__fill meter__fill--warning"
                                    : "meter__fill";

                            <div class="stat">
                                <div class="stat__label">@L["configs.traffic"]</div>
                                <div class="stat__value" style="font-size:var(--text-md)">
                                    @FormatBytes(subscription.RemainingBytes)
                                </div>
                                <div class="stat__meta">
                                    @L["configs.usedOf", FormatBytes(subscription.UsedBytes), FormatBytes(total)]
                                </div>
                                <div class="meter" style="margin-block-start:var(--space-2)"
                                     role="progressbar"
                                     aria-valuenow="@percent" aria-valuemin="0" aria-valuemax="100">
                                    <div class="@fillClass" style="width:@(percent)%"></div>
                                </div>
                            </div>
                        }

                        @if (subscription.ExpiresAt is { } expiresAt)
                        {
                            <div class="stat">
                                <div class="stat__label">@L["configs.expiresAt"]</div>
                                <div class="stat__value" style="font-size:var(--text-md)">
                                    <time datetime="@UserTime.ToIso8601(expiresAt)">
                                        @UserTime.Format(expiresAt, Model.TimeZoneId, "yyyy/MM/dd")
                                    </time>
                                </div>
                                @if (!isExpired && subscription.DaysRemaining is { } days)
                                {
                                    <div class="stat__meta">@L["configs.daysLeft", days]</div>
                                }
                            </div>
                        }

                        <div class="stat">
                            <div class="stat__label">@L["configs.serverCount"]</div>
                            <div class="stat__value">@subscription.Configs.Count</div>
                        </div>
                    </div>
                }

                @* ------------------------------------------------------------- problems ---- *@
                @if (failed)
                {
                    <div class="alert alert--warning" role="status">
                        @* The upstream's own text is never echoed; only our short reason. *@
                        <span>
                            @(subscription.LastFetchStatus == SubscriptionFetchStatus.Blocked
                                ? L["configs.blockedNotice"].Value
                                : L["configs.failedNotice"].Value)
                        </span>
                    </div>
                }
                else if (isExpired)
                {
                    <div class="alert alert--danger" role="status">
                        <span>@L["configs.expiredNotice"]</span>
                    </div>
                }

                @* --------------------------------------------------------------- configs ---- *@
                @if (subscription.Configs.Count > 0)
                {
                    <div data-config-island data-configs="@payload" data-labels="@labels"></div>

                    <noscript>
                        <div class="stack stack--tight">
                            @foreach (var config in subscription.Configs)
                            {
                                <div class="config-card">
                                    <div class="config-card__head">
                                        <span class="badge badge--accent badge--plain config-card__protocol">
                                            @config.Protocol.ToString().ToUpperInvariant()
                                        </span>
                                        <span class="config-card__name">@config.DisplayName</span>
                                    </div>
                                    @* Rendered in a textarea so it can still be selected and
                                       copied without scripting. *@
                                    <textarea class="input mono" readonly rows="2" dir="ltr"
                                              style="min-block-size:auto;padding:var(--space-2)"
                                              aria-label="@config.DisplayName">@config.RawUri</textarea>
                                </div>
                            }
                        </div>
                    </noscript>
                }
                else if (!failed)
                {
                    <p class="text-sm text-muted">@L["configs.noServers"]</p>
                }

                @* --------------------------------------------------------------- actions ---- *@
                <div class="cluster">
                    <form method="post" asp-action="Refresh">
                        <input type="hidden" name="id" value="@subscription.Id" />
                        <button type="submit" class="btn btn--ghost btn--sm">@L["configs.refresh"]</button>
                    </form>

                    <form method="post" asp-action="Remove">
                        <input type="hidden" name="id" value="@subscription.Id" />
                        <button type="submit" class="btn btn--danger btn--sm"
                                data-confirm="@L["configs.remove.confirm", subscription.Title]"
                                data-confirm-title="@L["configs.remove"]"
                                data-confirm-yes="@L["common.confirm"]"
                                data-confirm-no="@L["common.cancel"]">
                            @L["configs.remove"]
                        </button>
                    </form>
                </div>
            </div>
        </section>
    }

    @* ----------------------------------------------------------------------- add form ---- *@
    @if (Model.CanAddOwn && Model.Subscriptions.Count < Model.MaxSources)
    {
        <section class="card">
            <div class="card__header">
                <div>
                    <h2 class="card__title">@L["configs.add.title"]</h2>
                    <p class="card__hint">@L["configs.add.hint"]</p>
                </div>
            </div>

            <form method="post" asp-action="Add" class="stack">
                <div class="grid" style="grid-template-columns:1fr 2fr;gap:var(--space-3)">
                    <div class="field">
                        <label class="field__label" for="Title">@L["configs.add.label"]</label>
                        <input id="Title" name="Title" class="input" maxlength="120"
                               placeholder="@L["configs.add.labelPlaceholder"]" />
                    </div>

                    <div class="field">
                        <label class="field__label" for="Url">@L["configs.add.url"]</label>
                        <input id="Url" name="Url" class="input" type="url" dir="ltr" required
                               maxlength="2048" placeholder="https://…" autocomplete="off" />
                    </div>
                </div>

                <p class="text-xs text-muted">@L["configs.add.privacyNote"]</p>

                <div>
                    <button type="submit" class="btn btn--primary">@L["configs.add.submit"]</button>
                </div>
            </form>
        </section>
    }
</div>

@section Scripts {
    <script type="module" src="~/js/dist/page-configs.js" asp-append-version="true"></script>
}
