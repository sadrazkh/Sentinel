@model ErrorViewModel
@{
    Layout = "_LayoutAuth";
    ViewData["Title"] = L[Model.TitleKey].Value;
    ViewData["AuthTitle"] = L[Model.TitleKey].Value;
    var isAuthenticated = User.Identity?.IsAuthenticated == true;
}

<div class="stack">
    <p class="text-secondary text-sm">@L[Model.MessageKey]</p>

    @if (!string.IsNullOrEmpty(Model.CorrelationId))
    {
        @* The correlation id is the only technical detail the user ever sees. Exception
           types, messages and stack traces stay in the server log. *@
        <div class="card" style="padding:var(--space-4)">
            <div class="stat__label">@L["error.correlationId"]</div>
            <div class="mono" style="margin-block-start:var(--space-1)">@Model.CorrelationId</div>
            <p class="text-xs text-muted" style="margin-block-start:var(--space-2)">
                @L["error.correlationId.hint"]
            </p>
        </div>
    }

    @if (isAuthenticated)
    {
        <a class="btn btn--outline btn--block" asp-area="" asp-controller="Dashboard" asp-action="Index">
            @L["common.backToDashboard"]
        </a>
    }
    else
    {
        <a class="btn btn--outline btn--block" asp-area="" asp-controller="Account" asp-action="Login">
            @L["common.backToLogin"]
        </a>
    }
</div>
