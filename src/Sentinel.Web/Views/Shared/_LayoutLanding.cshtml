@using System.Globalization
@{
    var culture = CultureInfo.CurrentUICulture;
    var direction = PortalCultures.DirectionAttribute(culture);
    var nonce = ContentSecurityPolicyNonce.GetOrCreate(Context);
    var currentPath = $"{Context.Request.Path}{Context.Request.QueryString}";
    var isPersian = culture.TwoLetterISOLanguageName == "fa";
    var otherCulture = isPersian ? PortalCultures.English : PortalCultures.Persian;
    var otherCultureLabel = isPersian ? L["language.english"] : L["language.persian"];
}
<!DOCTYPE html>
<html lang="@culture.TwoLetterISOLanguageName" dir="@direction">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    <title>@(ViewData["Title"] ?? L["app.name"].Value) · @L["app.name"]</title>

    @* The one page an unauthenticated visitor is meant to read, so it gets a description.
       Everything behind the sign-in is deliberately not indexable. *@
    <meta name="description" content="@L["landing.metaDescription"]" />

    <link rel="icon" href="~/favicon.svg" type="image/svg+xml" />
    <link rel="stylesheet" href="~/css/sentinel.css" asp-append-version="true" />

    @* Applied before first paint so the page never flashes the wrong theme. Inline because it
       must run synchronously ahead of the stylesheet; the CSP nonce is what permits it. *@
    <script nonce="@nonce">
        (function () {
            try {
                var stored = window.localStorage.getItem('sentinel.theme');
                if (stored === 'light' || stored === 'dark') {
                    document.documentElement.setAttribute('data-theme', stored);
                }
            } catch (e) { /* storage blocked; fall back to the OS preference */ }
        })();
    </script>
</head>
<body class="landing">
<a class="visually-hidden" href="#main-content">@L["nav.skipToContent"]</a>

<header class="landing__header">
    <a class="brand" asp-area="" asp-controller="Home" asp-action="Index">
        <span class="brand__mark" aria-hidden="true">
            <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                 stroke-width="2.1" stroke-linecap="round" stroke-linejoin="round">
                <path d="M12 2.5 4.5 5.8v5.4c0 4.6 3.2 8.9 7.5 10.3 4.3-1.4 7.5-5.7 7.5-10.3V5.8z" />
                <path d="m9.2 12.1 2 2 3.6-3.9" />
            </svg>
        </span>
        <span class="brand__label">@L["app.name"]</span>
    </a>

    <span class="header-spacer"></span>

    <div class="header-actions">
        <button type="button"
                class="btn btn--icon"
                data-theme-toggle
                data-label-light="@L["theme.light"]"
                data-label-dark="@L["theme.dark"]"
                data-label-auto="@L["theme.auto"]"
                aria-label="@L["theme.toggle"]"
                title="@L["theme.toggle"]">
            <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                 stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <circle cx="12" cy="12" r="4" />
                <path d="M12 2.5v2M12 19.5v2M2.5 12h2M19.5 12h2M5.6 5.6l1.4 1.4M17 17l1.4 1.4M18.4 5.6 17 7M7 17l-1.4 1.4" />
            </svg>
        </button>

        <form method="post" asp-area="" asp-controller="Home" asp-action="SetLanguage">
            <input type="hidden" name="culture" value="@otherCulture" />
            <input type="hidden" name="returnUrl" value="@currentPath" />
            <button type="submit" class="btn btn--ghost btn--sm">@otherCultureLabel</button>
        </form>

        <a class="btn btn--primary btn--sm" asp-area="" asp-controller="Account" asp-action="Login">
            @L["landing.signIn"]
        </a>
    </div>
</header>

<main id="main-content" class="landing__main">
    @RenderBody()
</main>

<footer class="landing__footer">
    <span>@L["landing.footer"]</span>
</footer>

<script type="module" src="~/js/dist/site.js" asp-append-version="true"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
