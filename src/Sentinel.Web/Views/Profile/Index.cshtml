@model Sentinel.Web.Models.Account.ProfileViewModel
@{
    ViewData["Title"] = L["profile.title"].Value;
    var statusMessage = TempData["StatusMessage"] as string;

    var errors = ViewData.ModelState
        .SelectMany(entry => entry.Value!.Errors)
        .Select(error => error.ErrorMessage)
        .Where(message => !string.IsNullOrWhiteSpace(message))
        .Distinct()
        .ToList();

    string Localize(string message) =>
        message.Contains('.') && !message.Contains(' ') ? L[message].Value : message;
}

<div class="page-head">
    <div>
        <h1 class="page-head__title">@L["profile.title"]</h1>
        <p class="page-head__subtitle">@L["profile.subtitle"]</p>
    </div>
    <a class="btn btn--ghost btn--sm" asp-controller="Security" asp-action="Index">
        @L["nav.security"]
    </a>
</div>

@if (!string.IsNullOrEmpty(statusMessage))
{
    <div class="alert alert--success" role="status" style="margin-block-end:var(--space-6)">
        <span>@statusMessage</span>
    </div>
}

@if (errors.Count > 0)
{
    <div class="alert alert--danger" role="alert" style="margin-block-end:var(--space-6)">
        <div>
            @foreach (var error in errors)
            {
                <div>@Localize(error)</div>
            }
        </div>
    </div>
}

<div class="grid" style="grid-template-columns:repeat(auto-fit,minmax(min(100%,320px),1fr));align-items:start">

    <form method="post" class="card">
        <div class="card__header">
            <div>
                <h2 class="card__title">@L["profile.section.details"]</h2>
                <p class="card__hint">@L["profile.section.details.hint"]</p>
            </div>
        </div>

        <div class="stack">
            <div class="field">
                <label class="field__label" asp-for="DisplayName">@L["profile.displayName"]</label>
                <input class="input" asp-for="DisplayName" required maxlength="128" />
            </div>

            <div class="field">
                <label class="field__label" asp-for="PhoneNumber">@L["profile.phone"]</label>
                <input class="input" asp-for="PhoneNumber" type="tel" dir="ltr" maxlength="32"
                       placeholder="09121234567" autocomplete="tel" />
                <p class="text-xs text-muted">@L["profile.phone.hint"]</p>
            </div>

            <div class="grid" style="grid-template-columns:1fr 1fr">
                <div class="field">
                    <label class="field__label" asp-for="PreferredCulture">@L["profile.language"]</label>
                    <select class="input" asp-for="PreferredCulture">
                        <option value="fa" selected="@(Model.PreferredCulture == "fa")">@L["language.persian"]</option>
                        <option value="en" selected="@(Model.PreferredCulture == "en")">@L["language.english"]</option>
                    </select>
                </div>

                <div class="field">
                    <label class="field__label" asp-for="TimeZoneId">@L["profile.timeZone"]</label>
                    <select class="input" asp-for="TimeZoneId" dir="ltr">
                        @foreach (var zone in Model.TimeZoneOptions)
                        {
                            <option value="@zone" selected="@(Model.TimeZoneId == zone)">@zone</option>
                        }
                    </select>
                    <p class="text-xs text-muted">@L["profile.timeZone.hint"]</p>
                </div>
            </div>

            <div>
                <button type="submit" class="btn btn--primary">@L["profile.save"]</button>
            </div>
        </div>
    </form>

    <section class="card">
        <div class="card__header">
            <div>
                <h2 class="card__title">@L["profile.section.account"]</h2>
                <p class="card__hint">@L["profile.section.account.hint"]</p>
            </div>
        </div>

        <dl class="stack stack--tight">
            <div>
                <dt class="stat__label">@L["account.userName"]</dt>
                <dd class="mono" style="margin:var(--space-1) 0 0" dir="ltr">@Model.UserName</dd>
            </div>
            <div class="divider"></div>
            <div>
                <dt class="stat__label">@L["account.email"]</dt>
                <dd class="mono" style="margin:var(--space-1) 0 0" dir="ltr">
                    @(string.IsNullOrEmpty(Model.Email) ? L["account.notSet"].Value : Model.Email)
                </dd>
            </div>
        </dl>

        <p class="text-xs text-muted" style="margin-block-start:var(--space-4)">
            @L["profile.contactSupportToChange"]
        </p>
    </section>

    @if (Model.Telegram is { IsConfigured: true } telegram)
    {
        <section class="card" style="grid-column:1/-1">
            <div class="card__header">
                <div>
                    <h2 class="card__title">@L["telegram.title"]</h2>
                    <p class="card__hint">@L["telegram.subtitle"]</p>
                </div>
                @if (telegram.IsLinked)
                {
                    <span class="badge badge--success">@L["telegram.connected"]</span>
                }
                else
                {
                    <span class="badge badge--neutral">@L["telegram.notConnected"]</span>
                }
            </div>

            <div class="stack">
                @if (telegram.IsLinked)
                {
                    <dl class="stack stack--tight">
                        @if (!string.IsNullOrEmpty(telegram.TelegramUsername))
                        {
                            <div>
                                <dt class="stat__label">@L["telegram.account"]</dt>
                                <dd class="mono" style="margin:var(--space-1) 0 0" dir="ltr">
                                    @@@telegram.TelegramUsername
                                </dd>
                            </div>
                        }
                        @if (telegram.LinkedAt is { } linkedAt)
                        {
                            <div>
                                <dt class="stat__label">@L["telegram.linkedAt"]</dt>
                                <dd style="margin:var(--space-1) 0 0">
                                    <time datetime="@UserTime.ToIso8601(linkedAt)">
                                        @UserTime.Format(linkedAt, Model.TimeZoneId)
                                    </time>
                                </dd>
                            </div>
                        }
                    </dl>

                    <div class="divider"></div>

                    <div class="cluster">
                        <form method="post" asp-controller="Telegram" asp-action="SetNotifications">
                            <input type="hidden" name="enabled" value="@(!telegram.NotificationsEnabled)" />
                            <button type="submit" class="btn btn--outline btn--sm">
                                @(telegram.NotificationsEnabled
                                    ? L["telegram.mute"].Value
                                    : L["telegram.unmute"].Value)
                            </button>
                        </form>

                        <form method="post" asp-controller="Telegram" asp-action="Disconnect">
                            <button type="submit" class="btn btn--danger btn--sm"
                                    data-confirm="@L["telegram.disconnect.confirm"]"
                                    data-confirm-title="@L["telegram.disconnect"]"
                                    data-confirm-yes="@L["common.confirm"]"
                                    data-confirm-no="@L["common.cancel"]">
                                @L["telegram.disconnect"]
                            </button>
                        </form>
                    </div>

                    @if (!telegram.NotificationsEnabled)
                    {
                        <div class="alert alert--info" role="note">
                            <span>@L["telegram.mutedNotice"]</span>
                        </div>
                    }
                }
                else if (!string.IsNullOrEmpty(Model.TelegramDeepLink))
                {
                    @* Shown once, immediately after requesting a link. The URL carries a
                       single-use token that expires in minutes. *@
                    <div class="alert alert--success" role="status">
                        <div>
                            <p>@L["telegram.linkReady"]</p>
                            @if (Model.TelegramDeepLinkExpiresAt is { } expiresAt)
                            {
                                <p class="text-xs" style="margin-block-start:var(--space-2)">
                                    @L["telegram.linkExpires",
                                        UserTime.Format(expiresAt, Model.TimeZoneId, "HH:mm")]
                                </p>
                            }
                        </div>
                    </div>

                    <a class="btn btn--primary" href="@Model.TelegramDeepLink"
                       target="_blank" rel="noopener noreferrer">
                        @L["telegram.openTelegram"]
                    </a>

                    <p class="text-xs text-muted">@L["telegram.linkInstructions"]</p>
                }
                else
                {
                    <p class="text-sm text-secondary">@L["telegram.explainer"]</p>

                    <form method="post" asp-controller="Telegram" asp-action="Connect">
                        <button type="submit" class="btn btn--primary">@L["telegram.connect"]</button>
                    </form>
                }
            </div>
        </section>
    }
</div>
