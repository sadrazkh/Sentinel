@model Sentinel.Web.Models.Account.ProfileViewModel
@{
    ViewData["Title"] = L["profile.title"].Value;
    var statusMessage = TempData["StatusMessage"] as string;

    var errors = ViewData.ModelState
        .SelectMany(entry => entry.Value!.Errors)
        .Select(error => error.ErrorMessage)
        .Where(message => !string.IsNullOrWhiteSpace(message))
        .Distinct()
        .ToList();

    string Localize(string message) =>
        message.Contains('.') && !message.Contains(' ') ? L[message].Value : message;
}

<div class="page-head">
    <div>
        <h1 class="page-head__title">@L["profile.title"]</h1>
        <p class="page-head__subtitle">@L["profile.subtitle"]</p>
    </div>
    <a class="btn btn--ghost btn--sm" asp-controller="Security" asp-action="Index">
        @L["nav.security"]
    </a>
</div>

@if (!string.IsNullOrEmpty(statusMessage))
{
    <div class="alert alert--success" role="status" style="margin-block-end:var(--space-6)">
        <span>@statusMessage</span>
    </div>
}

@if (errors.Count > 0)
{
    <div class="alert alert--danger" role="alert" style="margin-block-end:var(--space-6)">
        <div>
            @foreach (var error in errors)
            {
                <div>@Localize(error)</div>
            }
        </div>
    </div>
}

<div class="grid" style="grid-template-columns:repeat(auto-fit,minmax(min(100%,320px),1fr));align-items:start">

    <form method="post" class="card">
        <div class="card__header">
            <div>
                <h2 class="card__title">@L["profile.section.details"]</h2>
                <p class="card__hint">@L["profile.section.details.hint"]</p>
            </div>
        </div>

        <div class="stack">
            <div class="field">
                <label class="field__label" asp-for="DisplayName">@L["profile.displayName"]</label>
                <input class="input" asp-for="DisplayName" required maxlength="128" />
            </div>

            <div class="field">
                <label class="field__label" asp-for="PhoneNumber">@L["profile.phone"]</label>
                <input class="input" asp-for="PhoneNumber" type="tel" dir="ltr" maxlength="32"
                       placeholder="09121234567" autocomplete="tel" />
                <p class="text-xs text-muted">@L["profile.phone.hint"]</p>
            </div>

            <div class="grid" style="grid-template-columns:1fr 1fr">
                <div class="field">
                    <label class="field__label" asp-for="PreferredCulture">@L["profile.language"]</label>
                    <select class="input" asp-for="PreferredCulture">
                        <option value="fa" selected="@(Model.PreferredCulture == "fa")">@L["language.persian"]</option>
                        <option value="en" selected="@(Model.PreferredCulture == "en")">@L["language.english"]</option>
                    </select>
                </div>

                <div class="field">
                    <label class="field__label" asp-for="TimeZoneId">@L["profile.timeZone"]</label>
                    <select class="input" asp-for="TimeZoneId" dir="ltr">
                        @foreach (var zone in Model.TimeZoneOptions)
                        {
                            <option value="@zone" selected="@(Model.TimeZoneId == zone)">@zone</option>
                        }
                    </select>
                    <p class="text-xs text-muted">@L["profile.timeZone.hint"]</p>
                </div>
            </div>

            <div>
                <button type="submit" class="btn btn--primary">@L["profile.save"]</button>
            </div>
        </div>
    </form>

    <section class="card">
        <div class="card__header">
            <div>
                <h2 class="card__title">@L["profile.section.account"]</h2>
                <p class="card__hint">@L["profile.section.account.hint"]</p>
            </div>
        </div>

        <dl class="stack stack--tight">
            <div>
                <dt class="stat__label">@L["account.userName"]</dt>
                <dd class="mono" style="margin:var(--space-1) 0 0" dir="ltr">@Model.UserName</dd>
            </div>
            <div class="divider"></div>
            <div>
                <dt class="stat__label">@L["account.email"]</dt>
                <dd class="mono" style="margin:var(--space-1) 0 0" dir="ltr">
                    @(string.IsNullOrEmpty(Model.Email) ? L["account.notSet"].Value : Model.Email)
                </dd>
            </div>
        </dl>

        <p class="text-xs text-muted" style="margin-block-start:var(--space-4)">
            @L["profile.contactSupportToChange"]
        </p>
    </section>
</div>
