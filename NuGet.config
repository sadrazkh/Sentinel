<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!-- Restrict restore to nuget.org only. Machine-wide feeds (private/DevExpress) are
       cleared so a build here can never silently pull a package from an unexpected source. -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
  <auditSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </auditSources>
</configuration>
